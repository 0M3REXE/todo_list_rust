{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "server.rs",
      "use": "@vercel/rust"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/server.rs" },
    { "src": "/(.*)", "dest": "/server.rs" }
  ],
  "crons": [
    {
      "path": "/api/maintenance/expired-sessions",
      "schedule": "0 4 * * *"
    }
  ]
}
