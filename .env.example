# Copy to `.env` and adjust. `.env` is gitignored because it holds a password.

# --- required ---
DATABASE_URL=postgres://postgres:postgres@localhost:6000/todos
ADDR=127.0.0.1:3000

# --- logging ---
# debug logs every request; info is enough for normal use.
RUST_LOG=info

# --- sessions ---
# Adds `Secure` to the session cookie. Leave this TRUE anywhere real: a Secure
# cookie is never sent over plain http, so setting it false on a public
# deployment silently logs everybody out. Set it to false only for local http.
SESSION_SECURE=false

# --- CSRF ---
# The `host[:port]` that POST/PUT/PATCH/DELETE requests are allowed to come
# from. Only the authority is compared, so http and https both match.
# A request with no Origin and no Referer is allowed through: browsers always
# send one, so its absence means a non-browser client rather than a forgery.
APP_ALLOWED_HOST=127.0.0.1:3000

# --- phase 3: email (not yet used) ---
# REQUIRE_EMAIL_VERIFICATION=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.com
# APP_BASE_URL=http://127.0.0.1:3000

# --- phase 5: rate limiting (not yet used) ---
# How the client IP is found. `direct` reads the socket address; `proxy` trusts
# X-Forwarded-For and MUST only be used behind a proxy that sets it, or a
# client can spoof its address and bypass the limiter entirely.
# TRUSTED_PROXY_MODE=direct