# Copy to `.env` and adjust. `.env` is gitignored because it holds a secret.

# --- required ---
# libsql://... or https://... — a Turso cloud database.
# Get these from: turso db create <name>  then  turso db tokens create
DATABASE_URL=libsql://<your-db>.turso.io
DATABASE_AUTH_TOKEN=<your-token>
ADDR=127.0.0.1:3000

# --- logging ---
# debug logs every request; info is enough for normal use.
RUST_LOG=info

# --- sessions ---
# Adds `Secure` to the session cookie. Leave this TRUE anywhere real: a Secure
# cookie is never sent over plain http, so setting it false on a public
# deployment silently logs everybody out. Set it to false only for local http.
SESSION_SECURE=false

# --- CSRF ---
# The `host[:port]` that POST/PUT/PATCH/DELETE requests are allowed to come
# from. Only the authority is compared, so http and https both match.
# A request with no Origin and no Referer is allowed through: browsers always
# send one, so its absence means a non-browser client rather than a forgery.
APP_ALLOWED_HOST=127.0.0.1:3000
